{
  "llm": {
    "provider": "ollama",
    "ollama": {
      "base_url": "http://localhost:11434",
      "model": "gpt-oss:latest",
      "embed_model": "nomic-embed-text",
      "timeout_seconds": 600
    },
    "openai": {
      "base_url": "http://localhost:11434",
      "model": "gpt-oss:latest",
      "embed_model": "nomic-embed-text",
      "timeout_seconds": 600,
      "api_key": "",
      "custom_headers": {
        "x-dep-ticket": "credential:",
        "User-Type": "AD_ID",
        "User-Id": "",
        "Send-System-Name": "project-manager-app"
      }
    },
    "temperature": 0.2
  },
  "jira": {
    "base_url": "",
    "token": "",
    "api_version": "2",
    "verify_ssl": true,
    "ca_bundle": "",
    "enable_http_logging": false,
    "retry_total": 6
  },
  "confluence": {
    "base_url": "",
    "token": "",
    "verify_ssl": true,
    "ca_bundle": "",
    "enable_http_logging": false,
    "request_delay_seconds": 10,
    "retry_total": 1,
    "extra_page_max_chars": 3000
  },
  "database": {
    "url": "sqlite:///./app.db"
  },
  "logging": {
    "directory": "./logs",
    "level": "INFO",
    "rotate_max_bytes": 10485760,
    "rotate_backups": 10
  },
  "scheduler": {
    "status_recompute_cadence": "daily",
    "weekly_aggregation_offset_minutes": 5,
    "timezone": "Asia/Kolkata"
  },
  "email": {
    "mock": true,
    "mock_log_path": "./logs/sent_emails.jsonl",
    "smtp_host": "",
    "smtp_port": 25,
    "from_address": "project-manager-app@noreply.local"
  },
  "reminders": {
    "hours_before_cutoff": 24,
    "hours_after_cutoff": 4
  },
  "reports": {
    "retention_weeks": 4,
    "default_template_path": "./data/report_template_default.md"
  },
  "engineers": {
    "mapping_file": "./data/engineer_project_mapping.json"
  },
  "holidays": {
    "calendar_file": "./data/holidays_ist_2026.json",
    "default_calendar_id": "default"
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "projects": []
}
